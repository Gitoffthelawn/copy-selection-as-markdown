#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

run_step() {
  local label="$1"
  shift
  echo "==> $label"
  time "$@"
}

if [[ ! -x "$HOME/.local/bin/mise" ]]; then
  run_step "Install mise" bash -c 'curl -fsSL https://mise.run | sh'
fi

export PATH="$HOME/.local/bin:$PATH"
run_step "Trust tool versions" mise trust "$repo_root/.mise.toml"
run_step "Install toolchain" mise install
run_step "Enable pnpm" mise exec -- corepack enable
run_step "Install dependencies" mise exec -- pnpm install --frozen-lockfile

browser_packages=(chromium firefox-esr fluxbox xvfb xdotool xclip)
missing_browser_packages=()
for package in "${browser_packages[@]}"; do
  dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q "ok installed" ||
    missing_browser_packages+=("$package")
done
if ((${#missing_browser_packages[@]})); then
  run_step "Update apt metadata" sudo apt-get update
  run_step "Install real-browser test dependencies" sudo apt-get install -y --no-install-recommends "${missing_browser_packages[@]}"
fi

profile_marker="# copy-selection-as-markdown mise environment"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# copy-selection-as-markdown mise environment
export PATH="$HOME/.local/bin:$PATH"
eval "$(mise activate bash)"
EOF
fi

echo "Orb setup complete."
