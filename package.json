{
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "run-s build:core build:browsers",
    "build:core": "pnpm --filter copy-selection-as-markdown-core run build",
    "build:browsers": "pnpm --filter copy-selection-as-markdown-firefox --filter copy-selection-as-markdown-chromium run build",
    "test": "pnpm --recursive test",
    "generate": "pnpm --filter copy-selection-as-markdown-firefox run generate",
    "format": "biome format --write",
    "lint": "run-s lint:biome lint:webextension",
    "lint:biome": "biome lint",
    "lint:webextension": "run-s build lint:firefox",
    "lint:firefox": "pnpm --filter copy-selection-as-markdown-firefox run lint",
    "check": "run-s check:biome lint:webextension",
    "check:biome": "biome check",
    "watch": "run-p watch:*",
    "watch:core": "pnpm --filter copy-selection-as-markdown-core run watch",
    "watch:firefox": "pnpm --filter copy-selection-as-markdown-firefox run watch",
    "clean": "pnpm --recursive run clean",
    "clean-node_modules": "run-s clean-node_modules:packages clean-node_modules:root",
    "clean-node_modules:packages": "rimraf packages/**/node_modules",
    "clean-node_modules:root": "rimraf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/firefox-webext-browser": "^143.0.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "web-ext": "^10.5.0"
  },
  "version": "0.23.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
