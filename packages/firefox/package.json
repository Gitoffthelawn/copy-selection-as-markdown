{
  "name": "copy-selection-as-markdown-firefox",
  "version": "0.23.0",
  "description": "copy-selection-as-markdown Firefox addon",
  "author": "0x6b",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0x6b/copy-selection-as-markdown"
  },
  "scripts": {
    "prebuild": "run-s clean generate-icons",
    "build": "node build.js",
    "clean": "rimraf dist/*",
    "generate-icons": "node icons/generate.js",
    "watch:webextension": "web-ext --browser-console --config=web-ext-config.cjs run",
    "watch:js": "node build.js --watch",
    "watch": "run-p watch:*",
    "pregenerate": "run-s build",
    "generate": "web-ext --config=web-ext-config.cjs build",
    "lint": "web-ext --config=web-ext-config.cjs lint"
  },
  "devDependencies": {
    "@primer/octicons": "^9.6.0",
    "xml2js": "^0.6.2"
  }
}
